# Wapzio Partner Panel environment
# Copy to .env for local dev. On the server these live in the server .env and in
# GitHub they are set as repo Variables (baked into the build by CI).

# Empty for root hosting. Set only if the panel is served under a sub-path.
NEXT_PUBLIC_BASE_PATH=

# Backend API base (must include /api).
#   local: http://localhost:5500/api
#   live:  https://api.wapzio.com/api
NEXT_PUBLIC_API_URL=http://localhost:5500/api

# Client app root — used to build the onboarding link the partner shares
# (<this>/join/<token>).
#   local: http://localhost:3000
#   live:  https://app.wapzio.com
NEXT_PUBLIC_FRONT_URL=http://localhost:3000

# reCAPTCHA v3 site key. Must be set whenever the backend has its secret set,
# or login is refused with RECAPTCHA_FAILED. Leave blank only if the backend has
# no RECAPTCHA_SECRET_KEY either.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
